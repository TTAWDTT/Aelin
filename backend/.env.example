# MERCURYDESK_CRAWLER_PLAYWRIGHT_POLL_SECONDS=10
# MERCURYDESK_AELIN_PARALLEL_MEMORY_DRAFT_ENABLED=true
# MERCURYDESK_AELIN_PARALLEL_MEMORY_DRAFT_WORKERS=4
# MERCURYDESK_AELIN_PARALLEL_MEMORY_DRAFT_TIMEOUT_SECONDS=2.0
# MERCURYDESK_AELIN_PARALLEL_MEMORY_DRAFT_MIN_CONFIDENCE=0.58
# MERCURYDESK_AELIN_BASE_CONTEXT_CACHE_TTL_SECONDS=4
# MERCURYDESK_AELIN_BASE_CONTEXT_CACHE_MAX_ENTRIES=128
# MERCURYDESK_AELIN_TRACKING_SNAPSHOT_CACHE_TTL_SECONDS=10
# MERCURYDESK_AELIN_TRACKING_SNAPSHOT_CACHE_MAX_ENTRIES=256
# MERCURYDESK_OPENVIKING_LOCAL_CACHE_MAX_ENTRIES=2000
# MERCURYDESK_LLM_REQUEST_TIMEOUT_SECONDS=90
# MERCURYDESK_MEDIA_INGEST_COOKIE_MODE=off
# MERCURYDESK_MEDIA_INGEST_COOKIE_BROWSER=chrome
# MERCURYDESK_MEDIA_INGEST_COOKIE_BROWSER_PROFILE=Default
# MERCURYDESK_MEDIA_INGEST_COOKIE_FILE=
# MERCURYDESK_MEDIA_INGEST_PROXY_URL=
# MERCURYDESK_MEDIA_INGEST_DOUYIN_AUTO_LOGIN_ENABLED=true
# MERCURYDESK_MEDIA_INGEST_DOUYIN_BROWSER_PROFILE_DIR=./browser_data/douyin_media
# MERCURYDESK_MEDIA_INGEST_DOUYIN_LOGIN_URL=https://www.douyin.com/
# MERCURYDESK_MEDIA_INGEST_DOUYIN_ASR_ENABLED=true
# MERCURYDESK_MEDIA_INGEST_DOUYIN_ASR_BACKEND=auto
